<?xml version="1.0"?>
<!--
  4-DOF SCARA (RRPR) for colour-sorted pick and place.

  Kinematic constants (MUST stay in sync with scara_kinematics.py):
    COLUMN_H = 0.40   column height, shoulder axis sits on top
    A1       = 0.25   upper arm length  (shoulder_pan -> elbow_pan)
    A2       = 0.20   forearm length    (elbow_pan    -> z_lift)
    QUILL    = 0.10   quill length hanging below the z_lift joint
    TOOL     = 0.03   suction pad length below wrist_roll

  Joint chain:
    shoulder_pan  revolute  about +Z at (0, 0, COLUMN_H)
    elbow_pan     revolute  about +Z at (A1, 0, 0)
    z_lift        prismatic along +Z at (A2, 0, 0), travel [-0.27, 0]
    wrist_roll    revolute  about +Z at (0, 0, -QUILL)
    tool_tip      fixed frame at the suction pad face, the grasp point

  Tool tip height:  z = COLUMN_H - QUILL - TOOL + d3 = 0.27 + d3
    d3 =  0.00  -> z = 0.27  (clear of everything)
    d3 = -0.23  -> z = 0.04  (touching the top of a 0.04 m cube on the table)
    d3 = -0.27  -> z = 0.00  (table surface, lower limit)

  Planar reach:  |A1 - A2| = 0.05  to  A1 + A2 = 0.45
-->
<robot name="scara">

  <material name="steel">   <color rgba="0.35 0.37 0.40 1"/></material>
  <material name="orange">  <color rgba="0.95 0.55 0.10 1"/></material>
  <material name="darkgrey"><color rgba="0.20 0.20 0.22 1"/></material>
  <material name="chrome">  <color rgba="0.75 0.76 0.78 1"/></material>
  <material name="black">   <color rgba="0.08 0.08 0.08 1"/></material>

  <!-- ============ WORLD ANCHOR ============ -->
  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============ OVERHEAD CAMERA (static, world-fixed) ============
       Matches scara_rl/sim_node.py's PyBullet camera exactly, so
       vision_node.py needs no changes:
         CAM_EYE_Z = 1.20, CAM_CENTER = (0.10, 0.14), CAM_FOV = 45 (vertical),
         CAM_W = CAM_H = 320.
       A gz-sim sensor looks along its own +X by default; rpy="0 pi/2 0"
       (pitch +90 deg) rotates local +X to world -Z, i.e. straight down.
       Square image (320x320, aspect 1) -> horizontal_fov == vertical_fov,
       so 45 deg = 0.7853981633974483 rad works for both. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="camera_fixed" type="fixed">
    <parent link="world"/>
    <child  link="camera_link"/>
    <!-- roll=-pi/2 added: pitch-only (roll=0) pointed the camera straight
         down correctly but left the image rotated +90 deg from what
         pixel_to_world expects (empirically confirmed: Dx=-Ty, Dy=Tx for
         all 3 known cubes). Derived analytically that roll=-pi/2 cancels
         it (roll=+pi/2 would land 180 deg off instead); verify against
         the same 3 cubes before trusting this. -->
    <origin xyz="0.10 0.14 1.20" rpy="-1.5707963267948966 1.5707963267948966 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="camera" name="overhead_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>overhead_camera/image_raw</topic>
      <camera>
        <horizontal_fov>0.7853981633974483</horizontal_fov>
        <image>
          <width>320</width>
          <height>320</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============ BASE COLUMN ============ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="8.0"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><cylinder radius="0.07" length="0.40"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20"/>
      <geometry><cylinder radius="0.07" length="0.40"/></geometry>
    </collision>
  </link>

  <!-- ============ LINK 1 : UPPER ARM (A1 = 0.25) ============ -->
  <link name="link1">
    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0070" iyz="0" izz="0.0075"/>
    </inertial>
    <visual>
      <origin xyz="0.125 0 0.015"/>
      <geometry><box size="0.28 0.07 0.055"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.125 0 0.015"/>
      <geometry><box size="0.28 0.07 0.055"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child  link="link1"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- +/- 135 deg -->
    <limit lower="-2.356" upper="2.356" effort="60" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ============ LINK 2 : FOREARM (A2 = 0.20) ============ -->
  <link name="link2">
    <inertial>
      <origin xyz="0.10 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0032" iyz="0" izz="0.0034"/>
    </inertial>
    <visual>
      <origin xyz="0.10 0 0.012"/>
      <geometry><box size="0.23 0.055 0.045"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.10 0 0.012"/>
      <geometry><box size="0.23 0.055 0.045"/></geometry>
    </collision>
  </link>

  <joint name="elbow_pan" type="revolute">
    <parent link="link1"/>
    <child  link="link2"/>
    <origin xyz="0.25 0 0.045" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- +/- 145 deg -->
    <limit lower="-2.530" upper="2.530" effort="40" velocity="3.0"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <!-- ============ LINK 3 : QUILL (prismatic Z) ============ -->
  <link name="link3">
    <inertial>
      <origin xyz="0 0 -0.05"/>
      <mass value="0.35"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry><cylinder radius="0.016" length="0.10"/></geometry>
      <material name="chrome"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05"/>
      <geometry><cylinder radius="0.016" length="0.10"/></geometry>
    </collision>
  </link>

  <joint name="z_lift" type="prismatic">
    <parent link="link2"/>
    <child  link="link3"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.27" upper="0.0" effort="80" velocity="0.5"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- ============ LINK 4 : WRIST / SUCTION PAD ============ -->
  <link name="link4">
    <inertial>
      <origin xyz="0 0 -0.015"/>
      <mass value="0.12"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.015"/>
      <geometry><cylinder radius="0.022" length="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.015"/>
      <geometry><cylinder radius="0.022" length="0.03"/></geometry>
    </collision>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="link3"/>
    <child  link="link4"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- ============ TOOL TIP : grasp reference frame ============ -->
  <link name="tool_tip">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="tool_fixed" type="fixed">
    <parent link="link4"/>
    <child  link="tool_tip"/>
    <origin xyz="0 0 -0.03" rpy="0 0 0"/>
  </joint>

  <!-- ============ ros2_control / Gazebo Sim wiring ============
       Joint names, limits, and every link above are untouched; this
       only exposes the existing joints to gz_ros2_control.

       z_lift is gravity-loaded (the quill/wrist assembly hangs off it) and
       position_controllers/JointGroupPositionController cannot hold it:
       gz_ros2_control's position interface is an open-loop P(position)->
       velocity hack whose gain (position_proportional_gain) is hardcoded
       to 0.1 in this build and is not reachable through any URDF/YAML/
       runtime-parameter route (tried and confirmed non-functional 7 ways).
       So z_lift alone commands through the *effort* interface, closed by
       joint_trajectory_controller's own PID (see scara_controllers.yaml),
       which properly counteracts gravity instead of faking it. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="shoulder_pan"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="elbow_pan"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="z_lift"><command_interface name="effort"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="wrist_roll"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find scara_description)/config/scara_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
